rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Kullanıcı belgesi (hangi ortak alana ait olduğu dahil)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Davet kodları: code -> spaceId
    // GÜVENLİK: yalnızca "get" (kodu bilen tek belgeyi okur); "list" KAPALI
    // (aksi halde saldırgan tüm davetleri listeleyip her alanın spaceId'sini öğrenir).
    match /invites/{code} {
      allow get:    if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/spaces/$(resource.data.spaceId)).data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    // Ortak alanlar (space): içindeki tüm listeler üyeler arasında paylaşılır
    match /spaces/{spaceId} {
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
      }

      allow read:   if isMember();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isMember();
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;

      // Üyeler: kişi yalnızca kendini ekler/çıkarır
      match /members/{memberUid} {
        allow read:   if isMember() || (signedIn() && memberUid == request.auth.uid);
        allow create: if signedIn() && memberUid == request.auth.uid;
        allow delete: if signedIn() && memberUid == request.auth.uid;
        allow update: if false;
      }

      // Sık eklenenler (otomatik tamamlama)
      match /frequent/{key} {
        allow read, write: if isMember();
      }

      // Listeler ve görevler: yalnızca alan üyeleri
      match /lists/{listId} {
        allow read, write: if isMember();
        match /todos/{todoId} {
          allow read, write: if isMember();
        }
      }
    }
  }
}

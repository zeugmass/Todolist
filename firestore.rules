rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── İZİNLİ KİŞİLER ────────────────────────────────────────────────────────
    // Uygulamayı YALNIZ bu hesaplar kullanabilir. Başka hiçbir hesap (yeni açılsa,
    // davet kodu ele geçirse bile) hiçbir belgeyi okuyamaz/yazamaz.
    // Yeni kişi eklemek: Firebase Auth'taki uid'sini buraya ekle + rules deploy.
    function allowed() {
      // (Bu repo herkese açık: burada e-posta/isim YAZMAYIN, yalnız uid.)
      return request.auth != null && request.auth.uid in [
        'oBakqJgdSzbm6HL1JBWcGTsI1kJ2', // hesap 1 (sahip)
        '7GBK0HeVh3cJyVrWanXUfnQHJTy2'  // hesap 2 (eş)
      ];
    }
    function spacePath(sid) { return /databases/$(database)/documents/spaces/$(sid); }
    function memberPath(sid, uid) { return /databases/$(database)/documents/spaces/$(sid)/members/$(uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }

    // Kullanıcı belgesi: yalnız kendisi
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // Davet kodları: code -> spaceId
    // - "list" KAPALI (kodlar listelenemez), yalnız kodu bilen tek belgeyi "get" eder.
    // - Yalnız ORTAK alan için, o alanın üyesi tarafından, 8 karakterlik, EN FAZLA
    //   ~24 saat geçerli kod oluşturulabilir. Katılınca silinir (tek kullanımlık).
    match /invites/{code} {
      allow get: if allowed();
      allow create: if allowed()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{8}$')
        && request.resource.data.keys().hasOnly(['spaceId', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
        && getAfter(spacePath(request.resource.data.spaceId)).data.shared == true
        && existsAfter(memberPath(request.resource.data.spaceId, request.auth.uid));
      // Silme: o alanın üyesi (sahip temizliği) ya da aynı işlemde üye olan (tek kullanım)
      allow delete: if allowed()
        && (exists(memberPath(resource.data.spaceId, request.auth.uid))
            || existsAfter(memberPath(resource.data.spaceId, request.auth.uid)));
      allow update: if false;
    }

    // Alanlar (space): içindeki tüm listeler üyeler arasında paylaşılır
    match /spaces/{spaceId} {
      function isMember() {
        return allowed() && exists(memberPath(spaceId, request.auth.uid));
      }

      allow read:   if isMember();
      allow create: if allowed() && request.resource.data.ownerUid == request.auth.uid;
      // Sahiplik (ownerUid) hiçbir zaman değiştirilemez
      allow update: if isMember() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isMember() && resource.data.ownerUid == request.auth.uid;

      // Üyeler: kişi yalnız KENDİNİ ekler/çıkarır. Eklemek için ya alanın sahibi
      // olmalı (alanı oluştururken) ya da bu alana ait, süresi dolmamış bir davet
      // kodu sunmalı. (Yalnız alan kimliğini bilmek artık katılmaya YETMEZ.)
      match /members/{memberUid} {
        allow read:   if isMember() || (allowed() && memberUid == request.auth.uid);
        allow create: if allowed() && memberUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email', 'joinedAt', 'inviteCode'])
          && (
            getAfter(spacePath(spaceId)).data.ownerUid == request.auth.uid
            || (
              request.resource.data.inviteCode is string
              && get(invitePath(request.resource.data.inviteCode)).data.spaceId == spaceId
              && get(invitePath(request.resource.data.inviteCode)).data.expiresAt > request.time
            )
          );
        allow delete: if allowed() && memberUid == request.auth.uid;
        allow update: if false;
      }

      // ── BEBEK TAKİBİ ────────────────────────────────────────────────────────
      // Yalnız alan üyeleri. Her kayıt biçim olarak doğrulanır (izin verilmeyen
      // alan, sahte yazar, saçma miktar/süre, uzak gelecek tarihi REDDEDİLİR).
      function validTimer(t) {
        return t == null || (t is map
          && t.keys().hasOnly(['kind', 'side', 'startedAt', 'startedBy'])
          && t.kind == 'breast' && t.side in ['L', 'R']
          && t.startedAt is int && t.startedBy is string);
      }
      function validSleepTimer(t) {
        return t == null || (t is map
          && t.keys().hasOnly(['startedAt', 'startedBy'])
          && t.startedAt is int && t.startedBy is string);
      }
      function validBaby(d) {
        return d.keys().hasOnly(['name', 'birthDate', 'createdAt', 'createdBy', 'feedReminderHours',
                                 'lastFeedAt', 'nextFeedAt', 'nextFeedNotifiedFor', 'activeTimer',
                                 'sleepTimer', 'lastBottleMl', 'lastMilk', 'tz'])
          && (!('sleepTimer' in d) || validSleepTimer(d.sleepTimer))
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && (!('birthDate' in d) || d.birthDate == null
              || (d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.feedReminderHours in [0, 3, 3.5, 4]
          && (!('lastFeedAt' in d) || d.lastFeedAt == null || d.lastFeedAt is int)
          && (!('nextFeedAt' in d) || d.nextFeedAt == null || d.nextFeedAt is int)
          && (!('nextFeedNotifiedFor' in d) || d.nextFeedNotifiedFor == null || d.nextFeedNotifiedFor is int)
          && (!('activeTimer' in d) || validTimer(d.activeTimer))
          && (!('lastBottleMl' in d) || (d.lastBottleMl is int && d.lastBottleMl >= 1 && d.lastBottleMl <= 500))
          && (!('lastMilk' in d) || d.lastMilk == null || d.lastMilk in ['breast', 'formula'])
          && (!('tz' in d) || (d.tz is string && d.tz.size() <= 64));
      }
      // Kayıt türleri: feed (beslenme), diaper (bez), sleep (uyku) — validEvent hepsini kapsar
      // Beslenme kaydı: biberon (ml) ya da emzirme (taraf + bitiş, en fazla 6 saat)
      function validFeed(d) {
        return d.keys().hasOnly(['type', 'method', 'at', 'endAt', 'ml', 'milk', 'side', 'note',
                                 'by', 'createdAt', 'updatedAt', 'tz'])
          && d.type == 'feed'
          && d.at is int && d.at > 1577836800000 && d.at < request.time.toMillis() + 86400000
          && d.by is string
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 200))
          && (!('tz' in d) || (d.tz is string && d.tz.size() <= 64))
          && (
            (d.method == 'bottle' && d.ml is int && d.ml >= 1 && d.ml <= 500
              && (!('milk' in d) || d.milk == null || d.milk in ['breast', 'formula'])
              && (!('side' in d) || d.side == null)
              && (!('endAt' in d) || d.endAt == null))
            || (d.method == 'breast' && d.side in ['L', 'R', 'both']
              && (!('ml' in d) || d.ml == null)
              && (!('milk' in d) || d.milk == null)
              && d.endAt is int && d.endAt >= d.at && d.endAt <= d.at + 21600000)
          );
      }
      // Ortak: zaman makul, yazar metin, not ≤200, saat dilimi ≤64
      function validCommon(d) {
        return d.at is int && d.at > 1577836800000 && d.at < request.time.toMillis() + 86400000
          && d.by is string
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 200))
          && (!('tz' in d) || (d.tz is string && d.tz.size() <= 64));
      }
      // Bez: ıslak ve/veya kirli (en az biri)
      function validDiaper(d) {
        return d.keys().hasOnly(['type', 'at', 'pee', 'poo', 'note', 'by', 'createdAt', 'updatedAt', 'tz'])
          && d.type == 'diaper' && validCommon(d)
          && d.pee is bool && d.poo is bool && (d.pee || d.poo);
      }
      // Uyku: başlangıç + bitiş (en fazla 16 saat)
      function validSleep(d) {
        return d.keys().hasOnly(['type', 'at', 'endAt', 'note', 'by', 'createdAt', 'updatedAt', 'tz'])
          && d.type == 'sleep' && validCommon(d)
          && d.endAt is int && d.endAt >= d.at && d.endAt <= d.at + 57600000;
      }
      // Gelişim ölçümü: kilo (gram), boy ve baş çevresi (mm) — en az biri, makul aralıkta
      function validGrowth(d) {
        return d.keys().hasOnly(['type', 'at', 'weightG', 'lengthMm', 'headMm', 'note', 'by', 'createdAt', 'updatedAt', 'tz'])
          && d.type == 'growth' && validCommon(d)
          && (!('weightG' in d) || d.weightG == null || (d.weightG is int && d.weightG >= 500 && d.weightG <= 30000))
          && (!('lengthMm' in d) || d.lengthMm == null || (d.lengthMm is int && d.lengthMm >= 250 && d.lengthMm <= 1300))
          && (!('headMm' in d) || d.headMm == null || (d.headMm is int && d.headMm >= 200 && d.headMm <= 600))
          && (d.get('weightG', null) != null || d.get('lengthMm', null) != null || d.get('headMm', null) != null);
      }
      // Vitamin/ilaç "verildi" kaydı: hangi takviye (m1..m5) + o anki adı (geçmiş, ad değişse de okunur)
      function validMedEv(d) {
        return d.keys().hasOnly(['type', 'at', 'medId', 'name', 'note', 'by', 'createdAt', 'updatedAt', 'tz'])
          && d.type == 'med' && validCommon(d)
          && d.medId in ['m1', 'm2', 'm3', 'm4', 'm5']
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40;
      }
      function validEvent(d) {
        return (d.type == 'feed' && validFeed(d)) || validDiaper(d) || validSleep(d) || validGrowth(d) || validMedEv(d);
      }
      // Günlük takviye (D vitamini vb.): ad, saat "SS:DD", son verilme bilgisi, sunucunun hatırlatma zamanı.
      // Kimlik yalnız m1..m5 olabilir → bebek başına EN FAZLA 5 takviye.
      function validMed(d) {
        return d.keys().hasOnly(['name', 'time', 'tz', 'createdAt', 'createdBy', 'updatedAt',
                                 'lastGivenAt', 'lastGivenBy', 'lastEventId', 'notifyAt', 'remindN'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && (!('tz' in d) || (d.tz is string && d.tz.size() <= 64))
          && (!('lastGivenAt' in d) || d.lastGivenAt == null
              || (d.lastGivenAt is int && d.lastGivenAt < request.time.toMillis() + 86400000))
          && (!('lastGivenBy' in d) || d.lastGivenBy == null
              || (d.lastGivenBy is string && exists(memberPath(spaceId, d.lastGivenBy))))
          && (!('lastEventId' in d) || d.lastEventId == null || (d.lastEventId is string && d.lastEventId.size() <= 40))
          && (!('notifyAt' in d) || d.notifyAt == null || d.notifyAt is int)
          && (!('remindN' in d) || d.remindN in [0, 1]);
      }
      match /babies/{babyId} {
        allow read:   if isMember();
        allow create: if isMember() && validBaby(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember() && validBaby(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember();

        match /events/{eventId} {
          allow read:   if isMember();
          // Yazar (by): kendisi ya da BU alanın bir üyesi (eşinin sildiği kaydı "geri al" için)
          allow create: if isMember() && validEvent(request.resource.data)
            && exists(memberPath(spaceId, request.resource.data.by));
          // Düzenlemede asıl yazar korunur (eşler birbirinin kaydını düzeltebilir)
          allow update: if isMember() && validEvent(request.resource.data)
            && request.resource.data.by == resource.data.by;
          allow delete: if isMember();
        }

        match /meds/{medId} {
          allow read:   if isMember();
          allow create: if isMember() && medId in ['m1', 'm2', 'm3', 'm4', 'm5']
            && validMed(request.resource.data)
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if isMember() && validMed(request.resource.data)
            && request.resource.data.createdBy == resource.data.createdBy;
          allow delete: if isMember();
        }
      }

      // Sık eklenenler (otomatik tamamlama)
      match /frequent/{key} {
        allow read, write: if isMember();
      }

      // Listeler ve görevler: yalnızca alan üyeleri
      match /lists/{listId} {
        allow read, write: if isMember();
        match /todos/{todoId} {
          allow read, write: if isMember();
        }
      }
    }

    // Yukarıda açıkça izin verilmeyen HER ŞEY reddedilir (Firestore varsayılanı).
  }
}
